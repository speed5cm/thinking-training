{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,52p' scripts/learning_evidence.py; sed -n '1,100p' scripts/validate_personal_roadmap.py; rg --files pilot-c01-c02 | rg 'coach.py\"'$'\"'; cat pilot-c01-c02/records/synthetic-p1/sigma/personal-roadmap.json\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Capture pilot observations and make conservative, non-executing recommendations.\"\"\"\nimport argparse\nimport contextlib\nimport datetime as dt\nimport fcntl\nimport hashlib\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport tempfile\n\nROOT = Path(__file__).resolve().parents[1]\nspec = importlib.util.spec_from_file_location('coach_for_evidence', ROOT / 'pilot-c01-c02/scripts/coach.py')\ncoach = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(coach)\nrspec = importlib.util.spec_from_file_location('roadmap_for_evidence', ROOT / 'scripts/generate_roadmap.py')\nroadmap = importlib.util.module_from_spec(rspec)\nrspec.loader.exec_module(roadmap)\n\nclass EvidenceError(ValueError):\n    pass\n\ndef get_folder(learner):\n    folder = coach.learner_dir(learner)\n    if not folder.is_dir():\n        raise EvidenceError('学习者记录不存在')\n    return folder\n\ndef load_evidence(folder):\n    path = folder / 'evidence.jsonl'\n    if not path.exists():\n        return []\n    try:\n        records = [json.loads(line) for line in path.read_text(encoding='utf-8').splitlines()]\n        if any(not isinstance(x, dict) for x in records):\n            raise ValueError('证据不是对象')\n        return records\n    except (ValueError, UnicodeError) as exc:\n        raise EvidenceError('证据文件损坏，停止处理') from exc\n\ndef current_card(concept, ref):\n    if concept not in ('C01', 'C02'):\n        raise EvidenceError('不属于已发布训练范围')\n    coach.gate(concept)\n    if ref['id'] in coach.MODES[concept]:\n        card, sha = coach.load_card(ref['id'], concept)\n        if ref['version'] == card['version']:\n            if ref['sha256'] != sha:\n                raise EvidenceError('题卡摘要不匹配')\n#!/usr/bin/env python3\n\"\"\"Validate an AI-authored planning proposal; never authorize or start teaching.\"\"\"\nimport argparse\nimport fcntl\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'scripts'))\nimport generate_roadmap as base\nimport learning_evidence as evidence\nimport sigma_session_store as sigma_session\n\nclass Invalid(ValueError):\n    pass\n\ndef digest(value):\n    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode()).hexdigest()\n\ndef context(learner, already_locked=False):\n    if not already_locked:\n        folder = evidence.get_folder(learner)\n        with (evidence.coach.ROOT / '.publication.lock').open('a') as publication, (folder / '.lock').open('a') as lock:\n            fcntl.flock(publication, fcntl.LOCK_SH)\n            fcntl.flock(lock, fcntl.LOCK_SH)\n            return context(learner, already_locked=True)\n    curriculum = base.build()\n    assessment = evidence.assess(learner, already_locked=already_locked)\n    recommendation = evidence.recommend(learner, already_locked=already_locked)\n    # Bind full Wiki text and pedagogy, not just extracted metadata.\n    paths = ['wiki/index.md', 'curriculum/12-week-plan.md', 'references/pedagogy.md', 'references/sources.md']\n    paths += [c['wiki_page'] for c in curriculum['concepts']]\n    contents = {p: (ROOT / p).read_text(encoding='utf-8') for p in paths}\n    folder = evidence.get_folder(learner)\n    # Raw coach events include routine questions and answers. Formal evidence and\n    # parent confirmation are bound independently; transient activity is not a\n    # reason to invalidate the whole plan.\n    names = ('planner-profile.md', 'evidence.jsonl', 'mastery-confirmation.json')\n    learner_files = {name: (folder / name).read_text(encoding='utf-8') if (folder / name).is_file() else None for name in names}\n    # Bind tutor decisions when present without invalidating existing plans with no tutor data.\n    tutor = folder / 'tutor-state.json'\n    if tutor.exists():\n        learner_files['tutor-state.json'] = tutor.read_text(encoding='utf-8')\n    sigma = folder / 'sigma'\n    if sigma.exists():\n        snapshot = sigma_session.read_folder(folder)\n        basis = snapshot['state'].get('planning_basis')\n        if basis is not None:\n            learner_files['sigma/planning_basis'] = basis\n    return {'curriculum': curriculum, 'curriculum_digest': digest(contents),\n            'learner_digest': digest(learner_files),\n            'evidence_digest': assessment['evidence_digest'], 'assessment': assessment,\n            'current_recommendation': recommendation}\n\ndef validate(plan, ctx, learner):\n    if not isinstance(plan, dict) or set(plan) != {'schema_version', 'learner', 'curriculum_digest', 'evidence_digest', 'learner_digest', 'steps', 'gaps', 'revision_suggestions'}:\n        raise Invalid('规划顶层字段不符合约定')\n    if type(plan['schema_version']) is not int or plan['schema_version'] != 1 or plan['learner'] != learner:\n        raise Invalid('版本或化名不匹配')\n    if plan['curriculum_digest'] != ctx['curriculum_digest'] or plan['evidence_digest'] != ctx['evidence_digest'] or plan['learner_digest'] != ctx['learner_digest']:\n        raise Invalid('Wiki 或学习证据已变化，须重新规划')\n    items = {c['id']: c for c in ctx['curriculum']['concepts']}\n    if not isinstance(plan['steps'], list) or not plan['steps']:\n        raise Invalid('步骤不能为空')\n    seen = set()\n    for step in plan['steps']:\n        if not isinstance(step, dict) or set(step) != {'kind', 'concept', 'reason', 'wiki_pages'}:\n            raise Invalid('步骤字段无效')\n        cid, kind = step['concept'], step['kind']\n        if not isinstance(cid, str) or cid not in items or kind not in ('introduce', 'review', 'interleave'):\n            raise Invalid('未知概念或步骤类型')\n        c = items[cid]\n        if not isinstance(step['reason'], str) or not step['reason'].strip():\n            raise Invalid(f'{cid}: 缺少依据')\n        pages = step['wiki_pages']\n        if not isinstance(pages, list) or not pages or any(not isinstance(p, str) for p in pages) or len(pages) != len(set(pages)):\n            raise Invalid(f'{cid}: Wiki 引用无效')\n        allowed = {x['wiki_page'] for x in items.values()}\n        if c['wiki_page'] not in pages or not set(pages) <= allowed:\n            raise Invalid(f'{cid}: 必须引用本概念页且不能引用未知页')\n        if kind == 'introduce':\n            if cid in seen or not set(c['hard_prerequisites']) <= seen:\n                raise Invalid(f'{cid}: 重复或硬先修未先列入路线')\n            seen.add(cid)\n        elif cid not in seen:\n            raise Invalid(f'{cid}: 复习或穿插须先列入概念')\n    if seen != set(items):\n        raise Invalid('须覆盖所有课程概念')\n    for key in ('gaps', 'revision_suggestions'):\n        if not isinstance(plan[key], list) or any(not isinstance(x, str) or not x.strip() for x in plan[key]):\n            raise Invalid(f'{key} 必须是非空文本组成的列表')\n    return {'valid': True, 'notice': '仅验证规划结构和快照，不验证语义或授予教学许可；先修排列不等于掌握。',\n            'current_recommendation': ctx['current_recommendation']}\n\ndef main():\n    p = argparse.ArgumentParser(description=__doc__)\n    p.add_argument('action', choices=['context', 'validate'])\n    p.add_argument('--learner', required=True)\npilot-c01-c02/scripts/coach.py\n{\n  \"schema_version\": 1,\n  \"learner\": \"synthetic-p1\",\n  \"curriculum_digest\": \"59e33c829943da8ccde45743c5994ff0f6de364349ead86e9df93773e6e9c334\",\n  \"evidence_digest\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\",\n  \"learner_digest\": \"6950d0e97c2536fa2c93a73f4886e382c7e75995c712225b0bade6fd77fcdbaf\",\n  \"steps\": [\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C01\",\n      \"reason\": \"无先修；正式证据为空，先以已发布诊断取得起点线索，再按门禁巩固。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/observation-vs-inference.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C02\",\n      \"reason\": \"在C01之后安排；尚无C01掌握证据与家长确认，暂不进入正式训练。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/attribute-comparison.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C03\",\n      \"reason\": \"先比较属性，再按明确属性分类及寻找反例。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/classification-counterexample.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C04\",\n      \"reason\": \"建立稳定比较维度后，识别并检验变化规则。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/pattern-rule.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C05\",\n      \"reason\": \"依赖分类与规律检验，学习有序且不重不漏地列举。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/systematic-enumeration.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C06\",\n      \"reason\": \"依赖事实辨析与枚举，检查条件方向及逆推。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/conditional-reasoning.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C07\",\n      \"reason\": \"依赖事实辨析与条件推理，审视证据范围和替代解释。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/evidence-and-alternatives.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C08\",\n      \"reason\": \"在证据判断之后组织理由，并公平倾听。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/structured-argument.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C09\",\n      \"reason\": \"依赖枚举与条件推理，整理目标及约束并检验方案。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/constraint-decomposition.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C10\",\n      \"reason\": \"依赖论证与约束分解，比较不同角色需求及方案代价。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/perspectives-tradeoffs.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C11\",\n      \"reason\": \"按课程叙事安排在方案设计阶段；C02/C09为可穿插关系，并非硬先修。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/divergent-ideas.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C12\",\n      \"reason\": \"依赖约束分解及发散构想，建立测试标准与迭代记录。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/prototype-testing.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C13\",\n      \"reason\": \"综合枚举、证据和约束方法，在新情境选择并验证策略。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/strategy-transfer.md\"\n      ]\n    },\n    {\n      \"kind\": \"introduce\",\n      \"concept\": \"C14\",\n      \"reason\": \"正式集中反思置于末段；C01/C09为可穿插关系，可早期记录具体自查动作。 仅列未来路线，未发布前不开展正式教学。\",\n      \"wiki_pages\": [\n        \"wiki/concepts/plan-monitor-reflect.md\"\n      ]\n    }\n  ],\n  \"gaps\": [\n    \"尚无学习者回答，理解、理由、提示依赖和体验均为unknown。\",\n    \"C01只有一张已发布训练卡，不能满足不同题卡掌握证据；C02正式训练先修未满足。\",\n    \"C03—C14没有已发布题卡，只列未来路线。\"\n  ],\n  \"revision_suggestions\": [\n    \"依真实回答调整教学动作；影响概念顺序或长期目标的实质变化才更新planning_basis并重规划。\",\n    \"补充不同题卡证据并经家长确认后，重新核查正式训练许可。\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
