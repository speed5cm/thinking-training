arner_lock, (dest/'.plan-lock').open('a') as lock:\nscripts/sigma_plan_store.py:85:            plan=json.loads(Path(candidate).read_text(encoding='utf-8'))\nscripts/sigma_plan_store.py:117:    p=argparse.ArgumentParser(description=__doc__);p.add_argument('action',choices=['publish','status','complete-review']);p.add_argument('--learner',required=True);p.add_argument('--plan');p.add_argument('--session');a=p.parse_args()\n#!/usr/bin/env python3\n\"\"\"Capture pilot observations and make conservative, non-executing recommendations.\"\"\"\nimport argparse\nimport contextlib\nimport datetime as dt\nimport fcntl\nimport hashlib\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport tempfile\n\nROOT = Path(__file__).resolve().parents[1]\nspec = importlib.util.spec_from_file_location('coach_for_evidence', ROOT / 'pilot-c01-c02/scripts/coach.py')\ncoach = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(coach)\nrspec = importlib.util.spec_from_file_location('roadmap_for_evidence', ROOT / 'scripts/generate_roadmap.py')\nroadmap = importlib.util.module_from_spec(rspec)\nrspec.loader.exec_module(roadmap)\n\nclass EvidenceError(ValueError):\n    pass\n\ndef get_folder(learner):\n    folder = coach.learner_dir(learner)\n    if not folder.is_dir():\n        raise EvidenceError('学习者记录不存在')\n    return folder\n\ndef load_evidence(folder):\n    path = folder / 'evidence.jsonl'\n    if not path.exists():\n        return []\n    try:\n        records = [json.loads(line) for line in path.read_text(encoding='utf-8').splitlines()]\n        if any(not isinstance(x, dict) for x in records):\n            raise ValueError('证据不是对象')\n        return records\n    except (ValueError, UnicodeError) as exc:\n        raise EvidenceError('证据文件损坏，停止处理') from exc\n\ndef current_card(concept, ref):\n    if concept not in ('C01', 'C02'):\n        raise EvidenceError('不属于已发布训练范围')\n    coach.gate(concept)\n    if ref['id'] in coach.MODES[concept]:\n        card, sha = coach.load_card(ref['id'], concept)\n        if ref['version'] == card['version']:\n            if ref['sha256'] != sha:\n                raise EvidenceError('题卡摘要不匹配')\n            return True\n    card, sha = coach.load_card(ref['id'], concept, version=ref['version'])\n    if ref['sha256'] != sha:\n        raise EvidenceError('历史题卡归档摘要不匹配')\n    # Authentic old records remain visible but require separate review before reuse.\n    return False\n\ndef capture(learner, session_id, extra):\n    if not isinstance(extra, dict) or set(extra) != {'reason_quote', 'transfer', 'parent_feedback'}:\n        raise EvidenceError('补充字段须为 reason_quote、transfer、parent_feedback')\n    transfer = extra['transfer']\n    if (not isinstance(extra['reason_quote'], str) or not isinstance(extra['parent_feedback'], str)\n        or not isinstance(transfer, dict) or set(transfer) != {'status', 'observation', 'parent_verified_novel'}\n        or transfer['status'] not in ('unknown', 'no', 'yes') or not isinstance(transfer['observation'], str)\n        or type(transfer['parent_verified_novel']) is not bool\n        or (transfer['parent_verified_novel'] and (transfer['status'] != 'yes' or not transfer['observation'].strip()))):\n        raise EvidenceError('补充字段格式无效')\n    folder = get_folder(learner)\n    with (coach.ROOT / '.publication.lock').open('a') as publication, (folder / '.lock').open('a') as lock:\n        fcntl.flock(publication, fcntl.LOCK_SH)\n        fcntl.flock(lock, fcntl.LOCK_EX)\n        events = coach.load_events(folder)\n        starts = [x for x in events if x.get('type') == 'start' and x.get('session_id') == session_id]\n        if len(starts) != 1 or starts[0].get('mode') not in ('C01', 'C02'):\n            raise EvidenceError('会话不存在或不是正式 C01/C02 训练')\n        start = starts[0]\n        concept = start['mode']\n        questions = start['questions']\n        if len(questions) != 1 or questions[0]['concept'] != concept:\n            raise EvidenceError('会话题卡不符合试点范围')\n        ref = questions[0]\n        if not current_card(concept, ref):\n            raise EvidenceError('只能采集当前已发布题卡的会话')\n        session_events = [x for x in events if x.get('session_id') == session_id]\n        attempts = [i for i, e in enumerate(session_events) if e.get('type') == 'attempt' and e.get('question') == ref['id']]\n        if not attempts:\n            raise EvidenceError('会话尚无作答')\n        if coach.status(session_events) != 'completed':\n            raise EvidenceError('会话尚未结束；结束后采集最后一次作答')\n        i = attempts[-1]\n        attempt = session_events[i]\n        previous = [x for x in session_events[:i] if x.get('question') == ref['id']]\n        hints = [x['level'] for x in previous if x.get('type') == 'hint']\n        support = [x['type'] for x in previous if x.get('type') in ('demo', 'final_explanation')]\n        records = load_evidence(folder)\n        if any(r.get('session_id') == session_id and r.get('card', {}).get('id') == ref['id'] for r in records):\n            raise EvidenceError('该会话题卡已经采集')\n        ai = attempt['ai_assessment']\n        record = {'schema_version': 1, 'captured_at': dt.datetime.now(dt.timezone.utc).isoformat(),\n                  'session_id': session_id, 'concept': concept,\n                  'card': {k: ref[k] for k in ('id', 'version', 'sha256')},\n                  'raw_response': attempt['raw_response'], 'reason_quote': extra['reason_quote'],\n                  'ai_temporary_correctness': ai['correctness'], 'explanation_quality': ai['explanation'],\n                  'hint_level': max(hints, default=0), 'prior_attempts': len(attempts) - 1, 'prior_support': support,\n                  'transfer': transfer, 'coach_parent_feedback': [x['text'] for x in session_events if x.get('type') == 'parent_feedback'],\n                  'parent_feedback': extra['parent_feedback']}\n        fd = os.open(folder / 'evidence.jsonl', os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)\n        with os.fdopen(fd, 'a', encoding='utf-8') as f:\nsed: can't read scripts/coach.py: No such file or directory\n","exit_code":2,"status":"failed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat wiki/concepts/systematic-enumeration.md pilot-c01-c02/wiki/index.md pilot-c01-c02/wiki/overview.md pilot-c01-c02/wiki/concepts/C01.md pilot-c01-c02/wiki/sources/project-research.md references/pedagogy.md; sed -n '1,105p' scripts/generate_roadmap.py; sed -n '1,125p' scripts/sigma_plan_store.py; rg -n 'def learner_dir|def gate|ROOT =|def recommend' pilot-c01-c02/scripts/coach.py scripts/learning_evidence.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat wiki/concepts/systematic-enumeration.md pilot-c01-c02/wiki/index.md pilot-c01-c02/wiki/overview.md pilot-c01-c02/wiki/concepts/C01.md pilot-c01-c02/wiki/sources/project-research.md references/pedagogy.md; sed -n '1,105p' scripts/generate_roadmap.py; sed -n '1,125p' scripts/sigma_plan_store.py; rg -n 'def learner_dir|def gate|ROOT =|def recommend' pilot-c01-c02/scripts/coach.py scripts/learning_evidence.py\"","aggregated_output":"# C05 系统枚举\n\n- **知识点编号**：C05\n- **主要周次**：W03\n- **训练能力**：逻辑推理；独立解决问题\n- **先修**：[[concepts/classification-counterexample]], [[concepts/pattern-rule]]\n- **概念定义（项目原创表述）**：固定一个维度，逐项列出合法情况，确保不重复、不遗漏。\n\n<!-- roadmap-metadata\n{\n  \"abilities\": [\n    \"逻辑推理\",\n    \"独立解决/元认知\"\n  ],\n  \"hard_prerequisites\": [\n    \"C03\",\n    \"C04\"\n  ],\n  \"interleavable\": []\n}\n-->\n\n## 教学动作\n确定选项和限制→按第一位分组→逐个列出→核数并检查。\n\n## 自编例子\n用1、2、3不重复地组成两位数，共6个。\n\n## 常见错误\n漏情况、重复计算、忽视“不能重复”等限制。\n\n## 掌握与迁移\n- **掌握判据**：新搭配题中能列出全部组合并解释为何完整。\n- **新情境**：衣帽组合、学习用品排列、菜单选择。\n\n## 三阶启发式引导\n1. 请先说你已经知道什么，不急着选答案。\n2. 哪条线索或哪一个限制能帮助你检查？\n3. 试着画一个表、示范一个局部步骤，再由你完成余下部分。\n\n## 对应题目\n- `ST-C05-01`\n- `ST-C05-02`\n\n## 来源与知识关系\n- **来源索引**：R02, R07（详见 `../../references/sources.md`）\n- **相关先修**：[[concepts/classification-counterexample]], [[concepts/pattern-rule]]\n- **版权**：本页表述和例子为本项目独立编写；不含原教材文本。\n# Wiki Index\n\n## Overview\n- [Overview](overview.md)\n\n## Sources\n- [项目原创研究材料](sources/project-research.md)\n\n## Concepts\n- [C01 观察事实与推测](concepts/C01.md) — 区分事实与推测 (Teaching Concept)\n- [C02 多属性比较](concepts/C02.md) — 用相同维度比较 (Teaching Concept)\n---\ntitle: 儿童思维试点\ntype: overview\nsources: [project-research]\n---\n# Overview\n\n## Current Scope\n本试点仅包括 C01 观察事实与推测，之后 C02 多属性比较。C02 正式训练依赖 C01；起点诊断仅取得线索，不赋予掌握状态。两概念的教学、提示和掌握条件以儿童版试点规则为准。\n\n## Threads in Progress\n1. [[concepts/C01]]：区分事实与推测。\n2. [[concepts/C02]]：依据同一维度比较，先修 C01。\n---\ntitle: C01 观察事实与推测\ntype: concept\ntags: [curriculum, observation, beginner]\nsources: [project-research]\nlast_updated: 2026-11-04\n---\n# C01 观察事实与推测\n\n## Core Thesis\n可直接核查的描述和对原因、经历、意图的猜测不同。\n\n## Problem Definition\n先说题目明确呈现的信息，再区分未直接给出的解释。\n\n## Terminology\n事实：可直接核查的描述；推测：可能的解释，需额外证据。\n\n## Mental Model\n看到/题设 → 事实；由线索猜原因 → 推测；再想如何核实。\n\n## Minimal Implementation\n说出事实、标出猜测、描述如何核实；不要求揣测人物心理。\n\n## System Position\n- Inherits from: 无。\n- Prepares for: [[concepts/C02]]。\n- Sources: [[sources/project-research]]。\n\n## Common Errors (Behavioral)\n把物品状态误当成已知发生过程。\n\n## Diagnostic Questions (Step 1)\n使用已发布的诊断题卡；不凭诊断结果直接标记掌握。\n\n## Question Bank (Step 3b — Socratic)\n仅使用经发布门禁批准的 C01 题卡。\n\n## Hint Escalation Ladder (Step 3c)\n先独立尝试；H1、H2、H3 均不揭示完整答案；另设平行示范。\n\n## Misconceptions (Step 3d — Cognitive)\n可能把推测当成观察；仅在有证据时记录，避免给孩子贴标签。\n\n## Mastery Check (Step 3g)\n两种陌生场景各有三条事实与一条推测并有核实办法；使用本项目的跨机会和低提示门槛，不使用上游 80% 门槛。\n\n## Practice Tasks (Step 3h)\n审查过的不同场景练习。\n---\ntitle: 项目原创研究材料\ntype: source\nsources: []\n---\n# 项目原创研究材料\n\n- C01 原概念：`../../../wiki/concepts/observation-vs-inference.md`，来源索引 R04、R06。\n- C02 原概念：`../../../wiki/concepts/attribute-comparison.md`，来源索引 R01、R04。\n- 样题原始参考：`../../../question-bank/original-examples.md`，原题声明为项目原创。\n- 来源索引：`../../../references/sources.md`；研究材料用于追溯思路，不将外部教材正文纳入题库。\n- 教法：`../../../references/pedagogy.md`。\n# 教学法、初始诊断与 Sigma Tutor 儿童化规则\n\n> 本文件是教学设计说明，不是直接可运行的软件系统。**[研究证据]** 引自官方研究/试验；**[课程建议]** 是结合9岁儿童学习情境的设计；**[未验证假设]** 是本12周试教需调整的规则。\n\n## 一、研究依据与不能推断的效果\n\n1. **[研究证据] 元认知与自我调节**：EEF 2025-11-13第二版教学指南及2025年Toolkit综述强调计划、监控、评价策略的明确教授、模型示范及结合学科任务；Toolkit涉及355项研究。参见 https://educationendowmentfoundation.org.uk/education-evidence/guidance-reports/metacognition 与 https://educationendowmentfoundation.org.uk/education-evidence/teaching-learning-toolkit/metacognition-and-self-regulation 。不能把整体教育成效直接等同为本课程效果。\n2. **[研究证据] 数学诊断与教学**：EEF 2017数学指导强调以形成性评估理解学生知识、误区与反馈；参见 https://educationendowmentfoundation.org.uk/education-evidence/guidance-reports/maths-ks-2-3 。\n3. **[研究证据] 口头表达与互动**：EEF 2025年口语互动证据综述包含188项研究，主要集中阅读理解、读写结果；可支持课程内的结构化讨论，但不能断言泛化至IQ。参见 https://educationendowmentfoundation.org.uk/education-evidence/teaching-learning-toolkit/oral-language-interventions 。\n4. **[教法来源]** Project Zero的See–Think–Wonder、Claim–Support–Question为有研究背景的可视化思维常规，其独立学习效果不应夸大。https://pz.harvard.edu/thinking-routines 。原常规文本及下载资料适用CC BY-NC-ND；本文件独立编写提问和任务。\n5. **[研究证据，含负面证据]** EEF第二次P4C试验共198校，没有发现其所测学业及社会沟通指标的显著收益。提供项目的SAPERE现使用Thoughtful品牌：https://www.thoughtful.org.uk/ 。https://educationendowmentfoundation.org.uk/projects-and-evaluation/projects/philosophy-for-children-effectiveness-trial 。仍可使用其讨论结构，但不能宣传为提高成绩的有效保证。\n6. **[未验证假设]** 本12周周期、20分钟时长、0—3评分、H0—H3提示、1/3/7/14天复习和升级标准是本项目独立拟定的操作参数，尚未经过对照试验验证。\n\n## 二、首次能力诊断（W01D1与W01D2内完成，不另加课时）\n\n**目的**：寻找起始难度及语言/操作偏好，不诊断智商、注意力障碍、学习障碍或心理特征。首两天先做六个短任务，每天3个；总计每个训练日仍20分钟，任务可用口头或画图回答，结束后保留正常观察练习。\n\n| 探测编号 | 核心能力 | 原创起点任务 | 重点观察（不只看对错） |\n|---|---|---|---|\n| D01 | 观察分析 | 桌上有红笔和蓝书；成人说“有人一定刚在写作业”，指出可见与猜测 | 能不能辨认无证据推断 |\n| D02 | 逻辑推理 | 红、蓝两种球配大、小两种盒子，列出全部搭配 | 是否有序、不重不漏（4种） |\n| D03 | 批判性思考 | “我问了2个人，他们都爱苹果，大家一定都爱苹果”有什么问题 | 能指出样本范围不足 |\n| D04 | 创造性思维 | 一个空纸盒，想出3个用途并说明如何做到 | 想法是否实质不同、可行 |\n| D05 | 语言表达 | “想让图书角更安静”给出观点和一个理由 | 能把观点、理由分开说 |\n| D06 | 独立解决/元认知 | “有12张贴纸，想平均分给3人”，你先怎么做，怎么算、如何检查 | 是否自主计划和复核（每人4张） |\n\n**实施安排**：W01D1先做D01、D03、D05；W01D2做D02、D04、D06。每项约2—3分钟、诊断部分约9分钟；余下时间用于第1周正常观察/比较。试探时可以按孩子兴趣换主题，但逻辑结构必须保持一致。\n\n**记录**：一项至少保存孩子原话/画图摘要、答案、正确性、理由、帮助程度、投入感受及是否熟悉题型。单次表现标记为“起点线索”，不可直接给出固定能力标签。中断或疲劳时标“无法评估”，不能按0分处理。\n\n## 三、单次20分钟 Tutor 运行规则\n\n1. **检索（2分钟）**：从上次或间隔复习任务中选一道简短非原题的微任务。\n2. **策略示范（3分钟）**：成人或AI在**不同的平行例题**中公开思考步骤（think-aloud），不能直接替孩子解当天测评原题。\n3. **探索（10分钟）**：呈现1道主任务，复杂时只问1个问题；留出安静思考、操作、画图时间。\n4. **理由（3分钟）**：请孩子说“为什么这么想”“还有什么情况”，开放题允许多种立场。\n5. **复盘（2分钟）**：孩子说今天有效的方法和一个待试方法；记录表现，生成下次任务。\n\n**模型对话限制**：一次最多一个主要认知问题和一个必要追问；不同于连续追问五个问题。不得把完整答案放进儿童可见的提示文本。中文优先、句子简短、少用术语；允许语音、实物和图示。不默认生成过量视觉内容。\n\n## 四、三级提示（H0—H3）及触发\n\n- **H0 独立**：完整题目后先等待思考；认可画图、掰手指、实物操作。若孩子正在尝试，即使答案错误也不打断。\n- **H1 轻提示**：孩子主动请求帮助、说不知道、明显长时间不动且同意引导，或已经尝试但卡在启动步骤时，问“我们已经知道什么？”“你准备先做哪一步？”。不给关键数字或答案。\n- **H2 结构提示**：H1后仍无法推进且孩子愿意继续时，明确关注一个条件或图示：“先固定十位再列个位”。不把整个解答交给孩子。\n- **H3 平行例题示范**：仍受阻或产生明显挫败时，用更简单且**非原题**的类似例子示范一个完整策略；本题可降级或留待复习。原题完整答案只在家长/教师视图中揭示。\n- **暂停/切换**：孩子表示疲劳、烦躁或不想继续，立即允许暂停；连续2次受挫改为更简单的可成功任务；若仍不愿意继续则结束当天，不用题量惩罚。\n- **时间只做提示信号**：[未验证假设] 若孩子沉默约30—60秒可轻问是否需要帮助，不以秒表强制推进。\n\n### “不知道”分支\n\n1. 先回应：“可以不知道。你希望先找一个线索、看看相似的小例子，还是今天先休息？”\n2. 选找线索：H1→孩子尝试→必要时H2；选例子：直接在更简单的**平行题**做H3；选休息：暂停。\n3. 当孩子说“不想回答为什么”，可改用“画出你怎么想”或“指出哪一步”；不强迫公开表达。\n4. 同一知识点如果多次需要H3，标记“需补先修/重设语言难度”，不是“孩子不努力”。\n\n### 正确答案之后还应做什么？\n\n- 首次正确：请孩子用自己的话说明一条关键理由；若没有理由，判为“答案对，理解待验证”，而非立即掌握。\n- 理由正确：提供**不同外观、相同逻辑结构**的新题检验迁移。\n- 孩子能在陌生情境自主选策略、能指出错误与边界，且无H2—H3提示，才记录较高独立掌握。\n- 严格区分“听过示范之后能够复述”与“未经提示能解决新题”。\n\n## 五、错误与示范时机\n\n| 情形 | 教学响应 | 禁止行为 |\n|---|---|---|\n| 算错但思路正确 | 请回看某个计算步骤，允许自行核对 | 立即说出正确数值 |\n| 违反限制条件 | 指向“必须/至少/最多”字眼，要求重新检验 | 代替孩子列完方案 |\n| 把推测当事实 | 问“你看到的是什么，哪部分是猜的？” | 嘲笑或急于否定 |\n| 逆推错误 | 让孩子构造一个B成立但A不成立的情况 | 只说“逻辑有问题” |\n| 开放问题立场与成人不同 | 只评价理由和证据，不评价迎合程度 | 强迫改成立场一致 |\n| 两轮提示无进展 | H3在平行题做示范，再回到简化任务 | 无限连续追问 |\n| 明显情绪受挫/拒绝 | 降低挑战、选择暂停或成功任务 | 用成绩、排名或羞耻激励 |\n\n## 六、理解、迁移与独立性评估\n\n**0—3能力量表（每个知识点独立记录）**：\n- 0：未完成目标动作，且适当帮助仍无进展；疲劳等无法评估情况应另标NA。\n- 1：在较多提示下部分完成；理由不清。\n- 2：核心方法正确，解释了关键理由；只需少量H1支持。\n- 3：未见过的新情境中独立完成，说明理由并主动检验限制、证据或反例。\n\n**H提示强度单独记录**：H0完全独立、H1启发、H2结构、H3平行示范。不能把得到H3后答对的结果记为独立掌握。\n\n**三种测试题**：练习题（同知识同形式）、迁移题（同结构异场景）、延迟复习题（至少隔几天且避免记忆原答案）。一个掌握标签需要多次证据支持。\n\n**[未验证假设] 升级门槛**：最近3次同类学习机会至少2次能力评分≥2，提示主要H0—H1，至少一道独立迁移题成功；否则保持难度或补先修。此门槛不同于Sigma原版“概念总分约80%”，不可声称二者统计等价。\n\n## 七、间隔复习与混合练习\n\n- [未验证假设] 新知识首次学习后1、3、7、14天安排回顾；每次用2—4分钟且题面变化，记录是否独立答出。\n- 每周五做一轮混合题，允许加入前两周知识，防止只按题型记套路。\n- 遇到困难先重学最短必需先修（如C06卡住先回C01条件与事实，而非将所有内容重教）。\n- 实施根据学校负担与孩子意愿调整，避免额外堆叠作业；休息不能被判低分。\n\n## 八、每日、每周、阶段反馈\n\n### 每日反馈（发给家长，短）\n\n```text\n日期/节次：W05D03\n今天任务：样本范围判断\n知识点：C07\n事实表现：孩子指出“问了3人不能代表全班”；主动提出“多问一些人”\n正确性/解释：正确/核心解释清晰\n独立度：H1\n评分：2/3（初步观察）\n主要错误：核实方案未明确调查总体\n孩子自评：“我会先看调查了多少人”\n下次：换一个班级投票场景做2分钟复习\n```\n\n### 每周家长汇报（固定结构）\n\n1. **已观察到的变化**：以具体作品/原话说明，不写“思维能力提高30%”。\n2. **六能力快照**：每项0—3或NA，附样本证据数和帮助级别；样本不足则说明无法判断。\n3. **需要巩固的知识点**：只列1—2项，关联对应误区及先修。\n4. **体验与负担**：孩子的兴趣、挫败、主动提问、暂停情况；不公开排名。\n5. **下周计划**：升级/维持/补先修的具体决定和理由。\n\n### 阶段反馈\n\n每第3周末使用三道新题+口头反思，分维度保存原答、提示等级、评价维度和日期；W12与起点不同题型但相似认知要求的任务比较。**单人、短期、自编量表不能证明智商变化或因果学习效果。**\n\n## 九、Sigma Tutor 与 Wiki Ingest 的具体关系\n\n**已核实源码**：\n- Sigma：https://github.com/sanyuan0704/sanyuan-skills/blob/main/skills/sigma/SKILL.md\n- Wiki Ingest：https://github.com/sanyuan0704/sanyuan-skills/blob/main/skills/wiki-ingest/SKILL.md\n\n原版Sigma包含诊断、1—2问/轮、约80%掌握门槛、复习状态等要求，并有**“NEVER give answers directly”**的不可变规则。[来源事实]\n\n**本项目实施建议：**\n- 不要直接声称Sigma已有儿童适龄、情绪保护或家长答案视图功能；应由Codex在经家长确认后建立**儿童版配置/分支或包装层**，并清楚标注与原版严格不直接给答案规则的差异。\n- 若不修改Sigma原核心规则：Tutor只可提问和提供符合原版约束的最小提示；**平行例题的完整示范由家长或教师在Sigma之外进行**，孩子无法继续时交由家长/教师处理，不得由未改版的Sigma直接揭示当题解答。\n- 若家长明确批准儿童版教学变更：保留原题答案默认隐藏，允许在适当失败次数后由教师端查看完整解析；儿童端可看到简化版**平行题讲解**。任何直接解答当题的能力都应作为显式产品决策而非默认行为。\n- 保留“先诊断、后推进”思想，但使用本项目的**多证据掌握门槛**而非照搬原版80%的口径。\n- Wiki Ingest“每知识实体一页”可应用于C01—C14，使用Obsidian风格 `[[concepts/slug]]`；`wiki/index.md`与`wiki/log.md`随维护更新。\n- Codex责任仅限编排和校验知识库：编号唯一性、先修无循环、闭合题答案一致、提示不泄答案、来源与许可检查、变式歧义审校、过程记录模板。**本阶段不构建完整应用。**\n\n## 十、知识库治理规范\n\n### 最小题目字段\n`id`、`concept_id`、`age_range`、`abilities`、`level`、`stem`、`answer_or_rubric`、`reasoning`、`hints[3]`、`common_errors`、`variant`、`variant_answer_or_rubric`、`source_kind`、`source_url_if_licensed`、`review_status`、`verification_status`。\n\n### 引导者的强制门禁\n1. **来源门禁**：只有原创或明确许可材料可收录题目正文；公开免费不等于可入库。\n2. **答案门禁**：封闭题须数学/逻辑二次校验；开放题要有明确过程量表，不可虚构标准唯一答案。\n3. **教学门禁**：孩子端不出现最终答案、完整推理和教师评语内的隐含剧透；按H1→H2→H3循序。\n4. **升级门禁**：单次答对不升级；必须跨新场景且帮助程度低。\n5. **反馈门禁**：不说“智商提升”“已经全面掌握”；长期数据不足则写“尚无充分证据”。\n6. **儿童隐私门禁**：默认最小记录、家长可查看/删除；不储存真实姓名、家庭住址、学校、照片或语音原件，除非家长明确决定并理解风险。\n\n### Wiki Ingest 推荐流程\n1. 先登记资料URL、版权许可、访问日期到 `sources.md`。\n2. 从合法材料中人工提取教学**思想**，重新用自己的语言定义每个概念；严禁把有复制/数据库限制的来源原文粘贴进Wiki或用于自动抓取。\n3. 建立独立的 `wiki/concepts/<slug>.md`、先修关系、对应原创题ID。\n4. 更新`wiki/index.md`与`wiki/log.md`，检查知识点引用均存在。\n5. 由Codex离线检查闭合题答案、元数据与四阶段周数；再由成人试教审核歧义和年龄适配度。\n6. Sigma Tutor阅读每节对应知识点和一题儿童可见题面；答案、推理和完整评分标准保留教师视图。\n\n## 十一、待验证假设和试教观察点\n\n- 20分钟是否适合此孩子，且口语/动手任务占比是否需要调整。\n- 每周五天是否在校内作业之外形成过高负担。\n- 3级提示是否足以区分“临时卡住”和“缺少先修”。\n- 0—3评分能否在不同引导者之间保持一致；需要从实际口头材料建立评分示例集。\n- 12周课程是否出现跨题型迁移；没有对照组时只可做个人成长描述，不做因果归因。\n#!/usr/bin/env python3\n\"\"\"Build a conservative, static curriculum projection from the root Wiki.\"\"\"\nimport argparse\nimport html\nimport importlib.util\nimport json\nimport re\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nABILITIES = {'观察分析', '逻辑推理', '批判性思考', '创造性思维', '独立解决/元认知', '语言表达'}\nDOMAINS = ABILITIES\n\nclass Invalid(ValueError):\n    pass\n\ndef build(root=ROOT):\n    root = Path(root)\n    wiki = root / 'wiki'\n    index = (wiki / 'index.md').read_text(encoding='utf-8')\n    rows = re.findall(r'^\\| (C\\d{2}) \\| \\[\\[concepts/([^\\]]+)\\]\\][^|]*\\|[^|]*\\|([^|]*)\\|', index, re.M)\n    entries = [(cid, slug) for cid, slug, _ in rows]\n    index_dependencies = {cid: set(re.findall(r'C\\d{2}', deps)) for cid, _, deps in rows}\n    if len(entries) != 14 or set(x[0] for x in entries) != {f'C{i:02}' for i in range(1, 15)} or len(set(x[1] for x in entries)) != 14:\n        raise Invalid('Wiki 索引必须唯一列出 C01—C14')\n    pages = list((wiki / 'concepts').glob('*.md'))\n    if {p.stem for p in pages} != {slug for _, slug in entries}:\n        raise Invalid('概念页与索引不一致（缺失或未收录）')\n    source_text = (root / 'references/sources.md').read_text(encoding='utf-8')\n    sources = set(re.findall(r'^## (R\\d\\d)\\b', source_text, re.M))\n    slug_to_id = {slug: cid for cid, slug in entries}\n    concepts = []\n    for cid, slug in entries:\n        path = wiki / 'concepts' / (slug + '.md')\n        text = path.read_text(encoding='utf-8')\n        def one(pattern, label):\n            match = re.search(pattern, text, re.M | re.S)\n            if not match or not match.group(1).strip():\n                raise Invalid(f'{cid}: 缺少 {label}')\n            return match.group(1).strip()\n        name = one(r'^# (C\\d{2} [^\\n]+)', '标题')\n        if not name.startswith(cid + ' ') or one(r'\\*\\*知识点编号\\*\\*：([^\\n]+)', 'ID') != cid:\n            raise Invalid(f'{cid}: ID 不一致')\n        meta = json.loads(one(r'<!-- roadmap-metadata\\s*(\\{.*?\\})\\s*-->', '结构化映射'))\n        if set(meta) != {'abilities', 'hard_prerequisites', 'interleavable'}:\n            raise Invalid(f'{cid}: 映射字段无效')\n        for key in meta:\n            if not isinstance(meta[key], list) or any(not isinstance(x, str) for x in meta[key]) or len(meta[key]) != len(set(meta[key])):\n                raise Invalid(f'{cid}: {key} 无效')\n        if not meta['abilities'] or not set(meta['abilities']) <= ABILITIES:\n            raise Invalid(f'{cid}: 能力领域无效')\n        hard, inter = meta['hard_prerequisites'], meta['interleavable']\n        if set(hard) & set(inter) or any(x not in slug_to_id.values() or x == cid for x in hard + inter):\n            raise Invalid(f'{cid}: 依赖无效或缺失')\n        old_links = re.findall(r'\\[\\[concepts/([^\\]]+)\\]\\]', one(r'^- \\*\\*先修\\*\\*：([^\\n]+)', '先修'))\n        if (any(x not in slug_to_id for x in old_links) or\n                {slug_to_id[x] for x in old_links} != set(hard + inter) or\n                index_dependencies[cid] != set(hard + inter)):\n            raise Invalid(f'{cid}: 结构化关系与 Wiki 先修不一致')\n        source_ids = re.findall(r'R\\d\\d', one(r'\\*\\*来源索引\\*\\*：([^\\n]+)', '来源'))\n        if not source_ids or not set(source_ids) <= sources:\n            raise Invalid(f'{cid}: 来源索引无效')\n        goal = one(r'\\*\\*掌握判据\\*\\*：([^\\n]+)', '教学目标')\n        concepts.append({'id': cid, 'name': name[4:], 'wiki_page': str(path.relative_to(root)), 'source_registry': 'references/sources.md', 'sources': source_ids, 'teaching_goal': goal, **meta})\n    if not DOMAINS <= {a for c in concepts for a in c['abilities']}:\n        raise Invalid('六项能力覆盖不完整')\n    # Topological reachability from all hard-dependency roots; soft edges do not block.\n    reached = set()\n    while True:\n        ready = {c['id'] for c in concepts if set(c['hard_prerequisites']) <= reached} - reached\n        if not ready:\n            break\n        reached |= ready\n    if len(reached) != len(concepts):\n        raise Invalid('循环依赖或不可达路径: ' + ', '.join(sorted(set(slug_to_id.values()) - reached)))\n    # Reuse the existing pilot gate; this is a snapshot, not authorization to teach.\n    spec = importlib.util.spec_from_file_location('pilot_coach', root / 'pilot-c01-c02/scripts/coach.py')\n    coach = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(coach)\n    for c in concepts:\n        cid = c['id']\n        c['published_cards'] = []\n        c['teaching_status'] = 'blocked_no_published_card'\n        if cid in ('C01', 'C02'):\n            try:\n                coach.gate(cid)\n                for qid in coach.MODES[cid]:\n                    card, sha = coach.load_card(qid, cid)\n                    c['published_cards'].append({'id': qid, 'version': card['version'], 'sha256': sha})\n                c['teaching_status'] = 'pilot_published'\n            except (coach.Stop, OSError, ValueError, KeyError, TypeError):\n                c['published_cards'] = []\n                c['teaching_status'] = 'blocked_pilot_gate'\n        c['formal_teaching_available'] = c['teaching_status'] == 'pilot_published'\n    return {'schema_version': 1, 'authority': 'wiki/index.md and wiki/concepts/*.md', 'notice': '静态快照；正式教学前须重新执行现有试点门禁和家长陪同流程。可用不表示先修已掌握。', 'ability_domains': sorted(DOMAINS), 'concepts': concepts}\n\ndef render(data):\n    esc = lambda x: html.escape(str(x), quote=True)\n    cards = []\n    for c in data['concepts']:\n        dep = lambda key: '、'.join(c[key]) or '无'\n        state = '试点题卡已发布（须现场再验）' if c['formal_teaching_available'] else '不可进入正式教学'\n        cards.append(f'<article><h2>{esc(c[\"id\"])} · {esc(c[\"name\"])}</h2><strong class=\"{\"ready\" if c[\"formal_teaching_available\"] else \"blocked\"}\">{state}</strong><p>硬性先修：{esc(dep(\"hard_prerequisites\"))}；可穿插：{esc(dep(\"interleavable\"))}</p><p>能力：{esc(\"、\".join(c[\"abilities\"]))}</p><p>目标：{esc(c[\"teaching_goal\"])}</p><p>来源：{esc(\"、\".join(c[\"sources\"]))} · <a href=\"../{esc(c[\"wiki_page\"])}\">概念 Wiki</a></p></article>')\n    return '<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>思维能力 Roadmap</title><style>body{font:16px/1.6 system-ui,sans-serif;max-width:1050px;margin:auto;padding:1.5rem;color:#172a35;background:#f3f6f6} main{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1rem} article{background:white;border:1px solid #d1dcdc;border-radius:10px;padding:1rem} h2{font-size:1.1rem;margin:0 0 .5rem}.ready{color:#14644e}.blocked{color:#9a3c21} p{margin:.5rem 0}</style></head><body><h1>思维能力 Roadmap</h1><p>' + esc(data['notice']) + '</p><p>硬性先修用于完整概念学习；可穿插关系不阻断早期练习。12 周计划仅供参考。</p><main>' + ''.join(cards) + '</main></body></html>\\n'\n#!/usr/bin/env python3\n\"\"\"Experimental validated Sigma plan snapshots and evidence-derived review queue.\"\"\"\nimport argparse\nimport datetime as dt\nimport fcntl\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport learning_evidence as evidence\nimport validate_personal_roadmap as planner\n\nclass Invalid(ValueError): pass\n\ndef sha(obj):\n    return hashlib.sha256(json.dumps(obj,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()).hexdigest()\n\ndef read(path):\n    return json.loads(path.read_text(encoding='utf-8')) if path.exists() else {'schema_version': 1, 'history': []}\n\ndef write(path, data):\n    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.plan-')\n    try:\n        os.fchmod(fd, 0o600)\n        with os.fdopen(fd,'w',encoding='utf-8') as f:\n            json.dump(data,f,ensure_ascii=False,indent=2);f.write('\\n');f.flush();os.fsync(f.fileno())\n        os.replace(name,path)\n        fd = os.open(path.parent,os.O_RDONLY)\n        try: os.fsync(fd)\n        finally: os.close(fd)\n    finally:\n        if os.path.exists(name): os.unlink(name)\n\ndef parse_date(value):\n    date=dt.datetime.fromisoformat(value)\n    if date.tzinfo is None: raise Invalid('证据时间必须带时区')\n    return date.astimezone(dt.timezone.utc)\n\ndef task_id(item):\n    return sha([item['concept'], item['evidence_session'], item['evidence_at']])\n\ndef event_task_id(event, history):\n    if 'task_id' in event:\n        return event['task_id']\n    # Existing experimental records bind completions to a plan and concept.\n    for item in history:\n        if item['version'] == event.get('plan_version'):\n            matches = [q for q in item['review_queue'] if q['concept'] == event.get('concept')]\n            if len(matches) == 1:\n                return task_id(matches[0])\n    raise Invalid('历史复习事件无法定位任务，停止处理')\n\ndef queue(records, history, events):\n    latest={}\n    for r in records:\n        when=parse_date(r['captured_at'])\n        if r['concept'] not in latest or when > latest[r['concept']][0]: latest[r['concept']]=(when,r)\n    result = [dict(q) for q in history[-1]['review_queue']] if history else []\n    for item in result:\n        item['task_id'] = task_id(item)\n    completed_sessions = {event['session_id'] for event in events}\n    for cid,(when,r) in sorted(latest.items()):\n        old = [q for q in result if q['concept'] == cid]\n        if r['session_id'] in completed_sessions or any(q['evidence_session'] == r['session_id'] for q in old):\n            continue\n        item = {'concept':cid,'evidence_session':r['session_id'], 'evidence_at':when.isoformat(),\n                'due_at':(when+dt.timedelta(days=1)).isoformat(), 'status':'pending',\n                'reason':'已有正式训练观察；一天后复习为实验安排，不表示掌握'}\n        item['task_id'] = task_id(item)\n        result.append(item)\n    return result\n\ndef operate(action, learner, candidate=None, session=None):\n    folder=evidence.get_folder(learner); dest=folder/'sigma';dest.mkdir(mode=0o700,exist_ok=True)\n    path=dest/'plan-history.json'\n    # Lock order is publication, learner, plan, shared with coach/evidence.\n    with (evidence.coach.ROOT/'.publication.lock').open('a') as pub, (folder/'.lock').open('a') as learner_lock, (dest/'.plan-lock').open('a') as lock:\n        fcntl.flock(pub,fcntl.LOCK_SH); fcntl.flock(learner_lock,fcntl.LOCK_EX); fcntl.flock(lock,fcntl.LOCK_EX)\n        store=read(path)\n        if store.get('schema_version') != 1 or not isinstance(store.get('history'),list): raise Invalid('规划历史损坏')\n        ctx=planner.context(learner, already_locked=True)\n        if action == 'publish':\n            plan=json.loads(Path(candidate).read_text(encoding='utf-8'))\n            planner.validate(plan,ctx,learner)\n            records=[r for r in evidence.load_evidence(folder) if evidence.current_card(r['concept'], r['card'])]\n            # Recheck Wiki and snapshots while holding the shared authorization locks.\n            if planner.context(learner, already_locked=True) != ctx: raise Invalid('规划输入发生变化，请重试')\n            item={'version':len(store['history'])+1,'plan_sha256':sha(plan),'created_at':dt.datetime.now(dt.timezone.utc).isoformat(),\n                  'inputs':{k:ctx[k] for k in ('curriculum_digest','learner_digest','evidence_digest')},'plan':plan,'review_queue':queue(records,store['history'],store.get('review_events',[]))}\n            store['history'].append(item);write(path,store)\n        if not store['history']: return {'status':'missing','review_queue':[]}\n        item=store['history'][-1]\n        if item['plan_sha256'] != sha(item['plan']): raise Invalid('规划内容摘要不匹配')\n        if action == 'complete-review':\n            records=evidence.load_evidence(folder)\n            matching=[r for r in records if r['session_id'] == session]\n            if len(matching) != 1: raise Invalid('须引用唯一已采集正式证据')\n            record=matching[0]\n            if not evidence.current_card(record['concept'], record['card']):\n                raise Invalid('历史题卡证据不能完成复习')\n            events=store.setdefault('review_events',[])\n            completed = {event_task_id(e, store['history']) for e in events}\n            pending=[q for q in item['review_queue'] if q['concept']==record['concept'] and q['evidence_session'] != session and task_id(q) not in completed and parse_date(record['captured_at']) > parse_date(q['evidence_at'])]\n            if len(pending) != 1 or any(e['session_id'] == session for e in events):\n                raise Invalid('没有可由此证据完成的复习')\n            events.append({'task_id':task_id(pending[0]), 'plan_version':item['version'], 'concept':record['concept'], 'session_id':session,'evidence_at':record['captured_at']})\n            write(path,store)\n        stale=any(item['inputs'][k] != ctx[k] for k in item['inputs'])\n        now=dt.datetime.now(dt.timezone.utc)\n        completed = {event_task_id(e, store['history']) for e in store.get('review_events',[])}\n        reviews=[{**q,'task_id':task_id(q),'due':parse_date(q['due_at']) <= now, 'status':'completed' if task_id(q) in completed else 'pending'} for q in item['review_queue']]\n        return {'status':'stale' if stale else 'current','version':item['version'],'plan_sha256':item['plan_sha256'], 'inputs':item['inputs'],'review_queue':reviews,'notice':'复习安排非掌握判定或教学授权；须重新检查实时门禁。'}\n\ndef main():\n    p=argparse.ArgumentParser(description=__doc__);p.add_argument('action',choices=['publish','status','complete-review']);p.add_argument('--learner',required=True);p.add_argument('--plan');p.add_argument('--session');a=p.parse_args()\n    try:\n        if a.action=='publish' and not a.plan: raise Invalid('publish 需要 --plan')\n        if a.action=='complete-review' and not a.session: raise Invalid('complete-review 需要 --session')\n        print(json.dumps(operate(a.action,a.learner,a.plan,a.session),ensure_ascii=False,indent=2))\n    except (Invalid, planner.Invalid, evidence.EvidenceError, evidence.coach.Stop, evidence.roadmap.Invalid, OSError, ValueError, KeyError, TypeError) as exc:\n        print('停止：'+str(exc),file=sys.stderr); return 1\n    return 0\nif __name__=='__main__': sys.exit(main())\nscripts/learning_evidence.py:15:ROOT = Path(__file__).resolve().parents[1]\nscripts/learning_evidence.py:213:def recommend(learner, already_locked=False):\npilot-c01-c02/scripts/coach.py:16:ROOT = Path(__file__).resolve().parents[1]\npilot-c01-c02/scripts/coach.py:48:def gate(concept):\npilot-c01-c02/scripts/coach.py:128:def learner_dir(learner):\n","exit_code":0,"status":"completed"}}
